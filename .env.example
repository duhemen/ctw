# Template environment CTW
# Copy ke .env lalu isi nilai sebenarnya

CTW_ENV=development
# development | staging | production

CTW_ENABLE_DOCS=true
# true = /docs terbuka, false = /docs tertutup

CTW_SESSION_SECRET=ganti-dengan-random-string-panjang
# Generate dengan: python -c "import secrets; print(secrets.token_urlsafe(64))"

# CTW_DATABASE_URL=sqlite:///C:/ctw/data/processed/ctw.db
