# CTW - Git ignore
# ============ Environment ============
.env
.env.local
.env.production
*.pem
*.key

# ============ Data besar ============
data/*.db
data/*.sqlite
data/raw/*.sql
data/raw/*.geojson
data/raw/*.shp
data/processed/geojson_cache/
data/processed/*.db
data/uploads/*
!data/uploads/.gitkeep
!data/raw/.gitkeep
!data/processed/.gitkeep

# ============ Python ============
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# ============ Venv ============
venv/
env/
.venv/

# ============ IDE ============
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# ============ Logs ============
*.log
logs/

# ============ Bootstrap & Backup ============
boot*.py
bootstrap*.py
push_github.py
*.bak
*.bak_*
